mall place for quick thoughts.</p>\n64\t          </div>\n65\t\n66\t          <button\n67\t            type=\"button\"\n68\t            className=\"theme-toggle\"\n69\t            onClick={toggleTheme}\n70\t            aria-label=\"Toggle dark mode\"\n71\t            aria-pressed={isDark}\n72\t            title=\"Toggle dark mode\"\n73\t          >\n74\t            <span className=\"theme-toggle-icon\" aria-hidden=\"true\">\n75\t              {isDark ? '☀' : '☾'}\n76\t            </span>\n77\t            <span className=\"theme-toggle-label\">Dark mode</span>\n78\t            <span className=\"theme-toggle-switch\" aria-hidden=\"true\">\n79\t              <span className=\"theme-toggle-knob\" />\n80\t            </span>\n81\t          </button>\n82\t        </header>\n83\t\n84\t        <main className=\"main\">\n85\t          <form className=\"composer\" onSubmit={handleSubmit}>\n86\t            <label className=\"composer-label\" htmlFor=\"note-input\">\n87\t              New note\n88\t            </label>\n89\t            <div className=\"composer-row\">\n90\t              <input\n91\t                id=\"note-input\"\n92\t                className=\"composer-input\"\n93\t                type=\"text\"\n94\t                value={draft}\n95\t                onChange={(event) => setDraft(event.target.value)}\n96\t                placeholder=\"Write a note...\"\n97\t                autoComplete=\"off\"\n98\t                aria-label=\"Note text\"\n99\t              />\n100\t              <button type=\"submit\" className=\"composer-button\">\n101\t                Add note\n102\t              </button>\n103\t            </div>\n104\t          </form>\n105\t\n106\t          <section className=\"notes\" aria-label=\"Notes\">\n107\t            <div className=\"notes-header\">\n108\t              <h2 className=\"notes-title\">Notes</h2>\n109\t              <span className=\"notes-count\">{notes.length}</span>\n110\t            </div>\n111\t\n112\t            {notes.lengt